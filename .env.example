# Local Postgres (docker compose); on Vercel this points at Neon
DATABASE_URL=postgresql://trip:trip@localhost:5432/trip_planner

# Auth.js — generate AUTH_SECRET with: npx auth secret   (ADR-0004: both providers)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Mapbox (server-side only)
MAPBOX_TOKEN=

# FX rates — exchangerate-api.com (ADR-0004)
EXCHANGE_RATE_API_KEY=
