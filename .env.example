# Local Postgres (docker compose); on Vercel this points at Neon
DATABASE_URL=postgresql://trip:trip@localhost:5432/trip_planner

# Auth.js — generate AUTH_SECRET with: npx auth secret   (ADR-0004: both providers)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Mapbox — MAPBOX_TOKEN is used server-side for geocoding (never sent to the browser).
# NEXT_PUBLIC_MAPBOX_TOKEN renders the map itself and IS sent to the browser — Mapbox's
# standard public token (pk.*, not sk.*) is designed for exactly this; the two can be
# the same token in practice.
MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_TOKEN=

# FX rates — exchangerate-api.com (ADR-0004)
EXCHANGE_RATE_API_KEY=

# Only needed to run a production build locally (`npm run build && npm run start`,
# which is what the e2e suite does). Auth.js auto-trusts the Host header in dev
# and on Vercel, but not on a bare `next start`. Do NOT set this on Vercel.
AUTH_TRUST_HOST=true
