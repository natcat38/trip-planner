{
  "name": "trip-planner",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:prod": "node -e \"process.env.PLAYWRIGHT_BASE_URL='https://trip-planner-cyan-five.vercel.app';process.env.SHARED_TRIP_PATH=process.env.SHARED_TRIP_PATH||'/shared/YzdiQTCwe_2LuWzMswg4YWTNDGEOwcMQ';require('child_process').execFileSync('npx',['playwright','test','e2e/ux-smoke.spec.ts'],{stdio:'inherit',env:process.env,shell:true})\"",
    "db:seed": "tsx prisma/seed.mts",
    "db:size": "tsx scripts/db-size.mts",
    "file-map": "node scripts/gen-file-map.mjs",
    "file-map:check": "node scripts/gen-file-map.mjs --check"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "mapbox-gl": "^3.30.0",
    "next": "16.2.11",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "^7.10.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
