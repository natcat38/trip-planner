{
  "manifest_version": 3,
  "name": "Trip Planner — save a place",
  "version": "1.0.0",
  "description": "Save a place to a trip from any webpage.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://trip-planner-cyan-five.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save this place to a trip"
  },
  "icons": {
    "128": "icon-128.png"
  }
}
