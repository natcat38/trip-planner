// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Models per Tech Scope §2.1, plus updatedAt on every mutable model per ADR-0003
// (optimistic locking) and cascade deletes Trip -> Day -> Activity / Trip -> Expense.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  trips         Trip[]

  // BYOK AI key (ADR-0011). One key per user, stored inline rather than in a
  // separate UserApiKey table with a one-to-one back-relation — a 1:1 table
  // is more moving parts (join, extra model, extra migration surface) for a
  // relationship that is exactly as optional as a nullable column already
  // expresses, and every one of these fields is null for most users. If this
  // ever grows into multiple keys per user, split it out then.
  // aiKeyCiphertext/aiKeyIv/aiKeyTag are AES-256-GCM parts from
  // src/lib/crypto.ts's encryptSecret() — never a plaintext key at rest.
  aiProvider      String? // "groq" | "openrouter"
  aiKeyCiphertext String?
  aiKeyIv         String?
  aiKeyTag        String?
  aiModel         String? // provider's live model id, e.g. "openai/gpt-oss-120b"
  aiKeyUpdatedAt  DateTime?

  // Browser-extension token (ADR-0017). Stored inline for the same reason as
  // the AI key above, and HASHED rather than encrypted: unlike the AI key,
  // this value never needs showing again after it is generated, so there is
  // nothing to decrypt it for. The token itself is 32 random bytes, so a
  // plain SHA-256 is the right primitive — bcrypt/argon2 exist to slow down
  // guessing of LOW-entropy secrets, and there is nothing here to guess.
  // @unique because verification looks a user up BY this hash.
  extensionTokenHash      String?   @unique
  extensionTokenCreatedAt DateTime?
}

// Auth.js Prisma adapter models (database sessions) — Google + GitHub OAuth, ADR-0004
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Trip {
  id            String             @id @default(cuid())
  userId        String
  name          String
  destinations  String[]
  startDate     DateTime
  endDate       DateTime
  baseCurrency  String // ISO 4217, e.g. "JPY"
  budgetMinor   Int // budget in base currency MINOR units
  shareToken    String?            @unique // set = public read-only link enabled; null = disabled
  updatedAt     DateTime           @updatedAt
  user          User               @relation(fields: [userId], references: [id])
  days          Day[]
  expenses      Expense[]
  collaborators TripCollaborator[]
  places        Place[]
  checklist     ChecklistItem[]
  attachments   Attachment[]

  @@index([userId])
}

model Day {
  id         String     @id @default(cuid())
  tripId     String
  date       DateTime
  // Itinerary content, like Activity.notes — and like it, this IS exposed on
  // the public /shared/[token] route. Deliberate: a shared itinerary that
  // hides the day's own plan is less useful than one that shows it. Do not
  // put anything private here.
  notes      String?
  updatedAt  DateTime   @updatedAt
  trip       Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  activities Activity[]

  @@index([tripId])
}

model Activity {
  id           String         @id @default(cuid())
  dayId        String
  title        String
  placeName    String?
  lat          Float?
  lng          Float?
  startTime    String? // "09:30"
  endTime      String?
  category     String // Food | Transport | Lodging | Sightseeing | Other
  notes        String?
  costMinor    Int? // in costCurrency MINOR units
  costCurrency String? // ISO 4217 of the original cost
  sortOrder    Int
  pinColor     String? // hex like "#e11d48"; null = the map's default pin
  placeId      String?
  updatedAt    DateTime       @updatedAt
  day          Day            @relation(fields: [dayId], references: [id], onDelete: Cascade)
  votes        ActivityVote[]
  place        Place?         @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@index([dayId])
  @@index([placeId])
}

model Expense {
  // big-ticket items not tied to a day (flights, hotels)
  id           String   @id @default(cuid())
  tripId       String
  label        String
  category     String
  costMinor    Int
  costCurrency String
  updatedAt    DateTime @updatedAt
  trip         Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model Place {
  id           String     @id @default(cuid())
  tripId       String
  source       String // "osm" | "manual"
  sourceId     String? // e.g. "node/1234567"
  name         String
  lat          Float
  lng          Float
  category     String // same vocabulary as Activity.category
  cuisine      String?
  openingHours String?
  website      String?
  phone        String?
  notes        String? // user's own research notes
  // Integer minor units + ISO 4217 per CLAUDE.md. Never a float.
  // User-entered: a price they read in the guide. No source gives this programmatically.
  costMinor    Int?
  costCurrency String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  trip         Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  activities   Activity[]

  @@unique([tripId, source, sourceId])
  @@index([tripId])
}

model ChecklistItem {
  // Packing lists and to-dos, scoped to a trip rather than a day: "pack the
  // charger" isn't a Tuesday thing.
  id        String   @id @default(cuid())
  tripId    String
  label     String
  done      Boolean  @default(false)
  sortOrder Int
  updatedAt DateTime @updatedAt
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model ActivityVote {
  // A single thumbs-up per person per activity — presence IS the vote, so
  // un-voting is a delete and there's no value column to keep in sync.
  // Keyed by email, not a User FK, for the same reason as TripCollaborator
  // (ADR-0006): collaborators are matched by their verified OAuth email and
  // may not have an account row at invite time.
  id         String   @id @default(cuid())
  activityId String
  voterEmail String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, voterEmail])
  @@index([activityId])
}

model TripCollaborator {
  // Invited by email, matched against the signed-in session's verified OAuth
  // email at access time — no userId FK, no separate invite-acceptance table.
  // updatedAt is present per CLAUDE.md's blanket "every mutable model carries
  // updatedAt" rule (ADR-0003), though this model has no field-level edits to
  // stale-write-protect — its mutations are create/status-transition/delete.
  id        String   @id @default(cuid())
  tripId    String
  email     String
  status    String   @default("PENDING") // PENDING | ACCEPTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, email])
  @@index([tripId])
  @@index([email])
}

model Attachment {
  // Booking confirmations, tickets, screenshots — the paperwork of a trip,
  // kept beside it. Stored as bytea in this database rather than in object
  // storage (ADR-0016): no new service, cascade-deleted with the trip, and
  // reachable only through the same requireTripAccess gate as everything else.
  //
  // The caps in src/server/attachments.ts are not a style choice. Neon's free
  // plan allows 0.5 GB for this ENTIRE database, and Vercel rejects any
  // function request or response over 4.5 MB — so a single file can never
  // exceed that no matter what this schema permits.
  //
  // Deliberately NOT exposed on /shared/[token]: a booking confirmation is
  // exactly the sort of thing that must not be world-readable. Per CLAUDE.md
  // that boundary is decided here and in src/server/sharing.ts, never at the
  // component layer.
  id         String   @id @default(cuid())
  tripId     String
  filename   String
  // Always one of ALLOWED_MIME_TYPES — never echoed back to a browser from
  // this column without re-checking, since a stored text/html would otherwise
  // be same-origin script. See the download route.
  mimeType   String
  sizeBytes  Int
  data       Bytes
  // Verified OAuth email of whoever uploaded it, like TripCollaborator
  // (ADR-0006) — a collaborator may have no User row. Nullable because
  // requireTripAccess authorises an owner on userId alone, so a session
  // carrying no email is still a legitimate uploader; provenance is a nicety
  // here, not an authorization input, and must never block the upload.
  uploadedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

// Coarse fixed-window rate limiting for the unauthenticated/token-only
// boundary (duplicateSharedTrip, /api/extension/*). $0/month constraint
// (ADR-0001) rules out Redis or any other paid service, and an in-memory
// counter would not survive Vercel's per-invocation serverless instances —
// so the window has to live somewhere every instance can see it, which here
// is this table. `key` encodes both the caller and the action (e.g.
// "share-duplicate:<token>" or "extension:<userId>") so different actions
// never share a bucket. One row per key: checkRateLimit atomically resets
// count when a new window has started, rather than tracking a sliding log
// of every request — fixed-window is bursty at the window boundary, but
// that imprecision is fine for a coarse abuse guard, not a billing meter.
model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int
}
